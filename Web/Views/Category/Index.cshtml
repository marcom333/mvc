@{
    if(ViewBag.user != null)
        Layout = "~/Views/Shared/_Plantilla.cshtml";
    ViewData["Title"] = "Productos";
}

@using Application.Entities

@model List<Category>

@if(ViewBag.Error!=null){
    <div class="alert alert-danger" role="alert">
        <strong>danger</strong> @ViewBag.Error
    </div>
}

<div class="d-flex rounded">
    <div class="card w-100 bg-secondary-subtle">
        <div class="card-body">
            <a asp-action="Create" asp-controller="Product" class="btn btn-success mb-3">
                Add New Product
            </a>
            <div class="bg-success-subtle px-2 pb-1 rounded border border-success">
                <table class="table table-striped table-bordered table-success table-hover mt-3">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Price</th>
                            <th>Options</th>
                        </tr>
                    </thead>
                    <tbody class="table-group-divider">
                        @foreach(Category c in Model){
                            <tr>
                                <td>@c.Name</td>
                                <td>@c.Description</td>
                                <td>
                                    <a asp-action="Detail" asp-controller="Category" asp-route-id="@c.CategoryId" class="btn btn-primary">Consultar</a>
                                    <a asp-action="Update" asp-controller="Category" asp-route-id="@c.CategoryId" class="btn btn-warning">Editar</a>
                                    <form asp-action="Delete" asp-route-id="@c.CategoryId" method="post">
                                        <input type="submit" class="btn btn-danger" value="Borrar">
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>