@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center d-flex justify-content-center">
    <div class="col-7 bg-secondary-subtle border border-secondary rounded-4 p-5">
        <h1 class="display-4">Bienvenidos</h1>
        <h4>Tienda en Línea de Kroces</h4>
        <p>Aquí podras realizar compras sobre nuestros productos, los cuales son de los mejores del mundo en su categoría.</p>
        <img class="mt-3 mb-3 img-fluid" src="~/img/awesome-face-png-1.png" alt="">
        <br>
        @if (User.Identity?.IsAuthenticated != true){
            <a class="btn btn-primary mt-3" asp-action="Login" asp-controller="Account">Iniciar Sesión</a>
        }
    </div>
</div>
