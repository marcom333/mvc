@{
    if(ViewBag.user != null)
        Layout = "~/Views/Shared/_Plantilla.cshtml";
    ViewData["Title"] = "Productos";
}

@using Application.Entities

@model PageResult<Product>

<form action="" method="get">
    <div class="form-group">
        <label for="">Nombre</label>
        <input type="text" class="form-control" name="name" value="@ViewBag.Name">
    </div>

    <button type="submit" class="btn btn-primary">Buscar</button>
</form>

@if(ViewBag.Error!=null){
    <div class="alert alert-danger" role="alert">
        <strong>danger</strong> @ViewBag.Error
    </div>
}

<div class="row">
    <div class="col-6">
        <h1>Conoce nuestros productos</h1>

        <p>
            <a class="btn btn-success" asp-action="Create" asp-controller="Product">Registrar</a>
        </p>

        <table class="table table-bordered table-hover table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Options</th>
                </tr>
            </thead>
            <tbody>
                @foreach(Product p in Model.Items){
                    <tr>
                        <td>@p.Name</td>
                        <td>@p.Price</td>
                        <td>
                            <div onclick="detalle(@p.ProductId)" class="btn btn-primary">Consultar</div>
                            <div onclick="editar(@p.ProductId)" class="btn btn-warning">Editar</div>
                            <form asp-action="Delete" asp-route-id="@p.ProductId" method="post">
                                <input type="submit" class="btn btn-danger" value="Borrar">
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-6" id="contenido">
        <div class="alert alert-info" role="alert">
            <strong>info</strong> Seleccione un Producto
        </div>
    </div>
</div>


<nav aria-label="Page navigation example">
  <ul class="pagination">
    <li class="page-item @(Model.Page>1?"":"disabled")"><a class="page-link" href="#" @(Model.Page>1?"":"aria-disabled=\"true\"")>Previous</a></li>

    @for(int renderPage = 1; renderPage <= Model.TotalPages; renderPage++){
        <li class="page-item"><a class="page-link" href="@Url.Action("Index2","Product")?page=@renderPage&name=@ViewBag.Name">@renderPage</a></li>
    }
    
    <li class="page-item"><a class="page-link" href="#">Next</a></li>
  </ul>
</nav>


@section Scripts{
    <script>
        function detalle(id){
            $.get("@Url.Action("Detail", "Product", new {id="_base_id_"})".replace("_base_id_", id), (data)=>{
                $("#contenido").html(data);
            });
        }
        function editar(id){
            $.get("@Url.Action("Update", "Product", new {id=0})".replace("0", id), (data)=>{
                $("#contenido").html(data);
            });
        }
    </script>
}

