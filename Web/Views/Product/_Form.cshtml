@using Application.Entities
@model Product

@Html.Label("Nombre")
@Html.TextBoxFor(m => m.Name, new { @class = "form-control" })

<div class="form-group">
        <label for="">Nombre</label>
        <input type="text"
               class="from-control"
               asp-for="Name" />
        <small id="helpId" class="from-text text-muted">Help text</small>
    </div>

    <div class="form-group">
        <label for="">Precio</label>
        <input type="number" class="from-control" asp-for="Price" />
        <small id="helpId" class="from-text text-muted">Help text</small>
    </div>

    <div class="form-group">
        <label for="">Descripcion</label>
        <textarea class="form-control" name="Description" id="" rows="3">@Model.Description</textarea>
    </div>

    <input type="hidden" value="@Model.UserId" name="UserId"/>
    <input type="hidden" value="@Model.CategoryId" name="CategoryId" />

    <p><button type="submit" class="btn btn-success">Guardar</button></p>