@using Application.Entities
@using Web.ViewModel

@model User

<div class="d-flex rounded">
    <div class="card w-100">
        <div class="card-body">
            <h1 class="border-bottom border-2 border-primary">User details</h1>
            <p>
                <a class="btn btn-warning" asp-action="Update" asp-route-id="@Model.UserId">Edit user</a> <br>
            </p>

            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th>Name</th>
                        <td>
                            @Model.Name <br>
                        </td>
                    </tr>
                    <tr>
                        <th>Email</th>
                        <td>@Model.Email</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>